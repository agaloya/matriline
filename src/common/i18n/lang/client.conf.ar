# source a16b9507457affa7
# ترجمة آلية لم تُراجَع بعد (machine translation, not yet reviewed)
# =============================================================================
# إعدادات عميل Matriline (الخيارات المحلية الخاصة بهذا الحاسوب)
# =============================================================================
# سياسة الشبكة (التشفير، وطريقة الانضمام، والملفات التي تُعاد، ...) يقرّرها الخادم وتصل
# تلقائيًا: لا تُضبط هنا، ولا يستطيع الخادم أن يجعل هذا الحاسوب يتجاوز الحدود التي تضعها
# أدناه.


[general]
# en: language of the menus, help and messages: "en", "es", "fr", "pt", "ar" (empty: this computer's)
# es: idioma de los menús, la ayuda y los mensajes: "en", "es", "fr", "pt", "ar" (vacío: el de esta computadora)
# fr: langue des menus, de l'aide et des messages : "en", "es", "fr", "pt", "ar" (vide : celle de cet ordinateur)
# pt: idioma dos menus, da ajuda e das mensagens: "en", "es", "fr", "pt", "ar" (vazio: o deste computador)
# ar: لغة القوائم والمساعدة والرسائل: "en", "es", "fr", "pt", "ar" (فارغ: لغة هذا الحاسوب؛ الترجمة العربية آلية ولم تُراجَع بعد)
language =


[client]
# ملف الاعتماد الذي أعطاك إياه مدير الخادم (أو الذي أنشأه "matriline-client join").
credential = credential.conf

# المكان الذي يحفظ فيه العميل حالته (هنا تنجو المهام الجارية من انقطاع الكهرباء).
state_dir = state

# لا يمكن تشغيل أكثر من عميل واحد لكل state_dir (يرفض العميل الثاني أن يبدأ). لإعارة هذا
# الحاسوب لمشروع آخر أيضًا، شغّل عميلًا ثانيًا بمجلد خاص به.
# المكان الذي يعمل فيه ORCA. فارغ = <state_dir>/jobs. استخدم قرصًا محليًا سريعًا.
scratch_dir =


[orca]
# تثبيتات ORCA المتاحة على هذا الحاسوب (الخادم يحدد أي إصدار يُستخدم).
paths = /opt/orca-6.1.1

# تثبيت OpenMPI للمهام متعددة الأنوية (resources.max_cores_per_job > 1): المجلد الذي
# يحتوي bin/mpirun. القيمة "auto" تبحث في PATH وفي /opt/openmpi-*. يحتاج ORCA 6.1 على
# Linux إلى OpenMPI 4.1.x. تُحسب بصمته كما تُحسب بصمة ORCA، ويعمل داخل البيئة المعزولة
# (sandbox) نفسها.
mpi_path = auto


[resources]
# أنوية المعالج المُعارة إلى Matriline (حساب واحد أحادي النواة لكل نواة).
# 0 = تلقائي: كل الأنوية الفعلية ناقص واحدة (الحاسوب ذو النواة الواحدة يستخدم نواته
# الوحيدة ويُصدر تحذيرًا).
cores = 0

# smt: احتساب الخيط العتادي الثاني في كل نواة (Hyper-Threading/SMT) نواةً أيضًا. معطّل
# افتراضيًا: بالقياس مع ORCA، مهمة ثانية على النواة نفسها لا تضيف سوى ~11 % من
# الإنتاجية، وتجعل كل مهمة أبطأ بنحو ~80 % والمعالج أسخن.
smt = false

# الذاكرة لكل نواة. يضبط العميل قيمة %maxcore في ORCA على 75 % من هذه القيمة (قد يتجاوز
# ORCA قيمة %maxcore)، ويُحذّر ويُعير أنوية أقل إذا لم تكن ذاكرة RAM في الحاسوب كافية.
memory_per_core = 1GiB

# أو مجموع لكل المهام معًا (مثلًا 12GiB؛ 0 = معطّل): تحصل كل مهمة افتراضيًا على حصة
# متساوية (memory_total / cores)، لكن المهمة المعروف أنها تحتاج ذاكرة أكبر لكل نواة
# (يعرف الخادم ذلك من أخطاء ORCA نفسه) أو المهمة متعددة الأنوية قد تأخذ أكثر ما دام
# الباقي متاحًا. عند ضبطه لا تُستخدم memory_per_core.
memory_total = 0

# أكبر حساب متعدد الأنوية مقبول (ملف إدخال فيه "%pal nprocs N" أو "! PALN"، حين يسمح بها
# الخادم). المهمة ذات N نواة تأخذ N من الأنوية أعلاه وN ضعف الذاكرة لكل نواة. 1 = مهام
# أحادية النواة فقط (الافتراضي: عدة مهام مستقلة تستفيد من الأنوية أفضل؛ بالقياس، نواتان
# تجعلان المهمة أسرع بنحو ~1.25x فقط). يحتاج إلى OpenMPI، انظر orca.mpi_path.
# macOS: دائمًا 1. بيئته المعزولة لا تستطيع حصر اتصالات OpenMPI في هذا الحاسوب، فتصبح
# للمهمة متعددة الأنوية إمكانية الوصول إلى الشبكة (docs/PORTING.md).
max_cores_per_job = 1

# قرص العمل المؤقت للحسابات الجارية، مثل الأنوية والذاكرة: مجموع لكل المهام معًا
# (disk_limit؛ لا مهام جديدة ما دام مستنفدًا)، و/أو مقدار ثابت لكل مهمة (disk_per_job؛
# المهمة التي تحتاج أكثر تُوقَف وتنتقل إلى حاسوب آخر). كلاهما بلا حد افتراضيًا: يتعلّم
# العميل كم يحتاج كل نوع من المهام، ولا يأخذ إلا مهمة تتسع لها المساحة.
disk_limit = unlimited

disk_per_job = unlimited

# ما يُترك فارغًا دائمًا على قرص العمل المؤقت للنظام والمستخدم، أيًّا كانت الحدود أعلاه؛
# تُوقَف المهمة الجارية إذا هبطت المساحة الفارغة عن نصفه.
# "auto" = 10 GiB، لكن 20 % من القرص على الأكثر (مثلًا 2 GiB على قرص 10 GB)؛ أو حجم محدد.
disk_reserve = auto

# حد سرعة رفع النتائج (10Mbit افتراضيًا؛ "unlimited" لإلغائه).
bandwidth_limit = 10Mbit


[schedule]
# لا تُقبل مهام جديدة إلا داخل هذه الفترات (المهام الجارية تكتمل دائمًا). فارغ = دائمًا.
# أمثلة: windows = mon-fri 20:00-07:00, sat-sun 00:00-24:00
windows =

# لا تُقبل مهام جديدة أثناء العمل على البطارية.
pause_on_battery = true

# أثناء تشغيل الحسابات والحاسوب موصول بالكهرباء، يمنع الحاسوب من الدخول في السكون من تلقاء
# نفسه (قد تنطفئ الشاشة؛ وإغلاق غطاء الحاسوب المحمول يُدخله في السكون رغم ذلك). على البطارية أو
# دون حسابات يدخل في السكون كالمعتاد. لا تتغير إعدادات الطاقة الخاصة به.
keep_awake = true

# عندما pause_on_battery = false: يتوقف قبول المهام الجديدة على البطارية تحت هذه النسبة
# من الشحن (نسبة مئوية، 0 = معطّل)؛ المهام الجارية تكتمل. يُستأنف أخذ المهام عند التوصيل
# بالكهرباء أو حين يرتفع الشحن battery_resume_margin نقطة فوق الحد (دون تذبذب حوله).
# الأجهزة التي لا بطارية نظام لها (الحواسيب المكتبية، والخوادم، والأجهزة الافتراضية) لا
# تتوقف بسبب هذا أبدًا.
min_battery_percent = 0

battery_resume_margin = 5

# لا تُقبل مهام جديدة ما دامت برامج أخرى تستخدم أكثر من هذه النسبة % من المعالج (0 =
# معطّل).
pause_when_busy_percent = 0


[limits]
# يُوقَف الحساب الذي يستمر أطول من هذه المدة (0 = بلا حد). تعود المهمة إلى الخادم لحاسوب
# آخر.
max_task_time = 0

# أكبر ملف منفرد يمكن أن يكتبه حساب (مثلًا 50G)، بلا حد افتراضيًا. قد تبلغ ملفات ORCA
# المؤقتة عدة GB (DLPNO)؛ وحماية قرص العمل المؤقت تحمي القرص.
max_file_size = unlimited

# يتوقف قبول المهام الجديدة ما دامت حرارة المعالج أعلى من هذه القيمة (درجات مئوية
# Celsius، 0 = معطّل، وهو الافتراضي). الحسابات الجارية تستمر؛ وتُستأنف الجديدة حين يبرد.
cpu_temperature_limit = 0

# مصدر قراءة الحرارة. فارغ = مستشعر المعالج في هذا الحاسوب. الملف الذي يحتوي رقمًا
# بالدرجات المئوية مفيد في جهاز افتراضي (لا مستشعر له) حين يكتب فيه المضيف حرارة معالجه،
# أو لأي مستشعر مخصص.
cpu_temperature_file =

# بعد هذا التاريخ (YYYY-MM-DD) يتوقف العميل ويعطّل نفسه. "never" افتراضيًا.
end_date = never


[security]
# تشغيل ORCA معزولًا: بلا وصول إلى الشبكة، وبلا وصول إلى ملفاتك خارج مجلد المهمة، وبلا
# برامج غير تثبيت ORCA. يُوصى به بشدة.
sandbox = true

# كل كم من الوقت يُعاد حساب البصمة (hash) لتثبيت ORCA كاملًا دون استخدام الذاكرة
# المخبئية (cache).
orca_deep_check_interval = 24h

# تثبيت إصدارات Matriline الجديدة حين يعرضها الخادم. لا تُثبَّت إلا الإصدارات الموقّعة
# بمفتاح مشرف Matriline (المدمج في هذا البرنامج)، أيًّا كان مُرسِلها؛ ويحدث ذلك بين
# المهام، ويبقى البرنامج السابق باسم <program>.previous.
updates = true

# المكان الذي تُنزَّل منه الإصدارات الجديدة (الخادم يحدد الإصدار فقط؛ ولا يختار العنوان
# أبدًا).
update_url = https://github.com/agaloya/matriline/releases