# source a0b4a6f30feccf8c
# ترجمة آلية لم تُراجَع بعد (machine translation, not yet reviewed)
# =============================================================================
# إعدادات خادم Matriline
# =============================================================================
# لهذا الملف ثلاثة أجزاء:
#   أساسي         الإعدادات القليلة التي تغيّرها معظم الخوادم (ابدأ من هنا)
#   متقدم         كل ما عدا ذلك، حسب القسم؛ القيم الافتراضية تناسب معظم المشاريع
#   EXPLANATIONS  ما يفعله كل خيار (الشروح)، بالترتيب نفسه الذي في «متقدم»
# الأقسام:   [general] اللغة                 [spool] مجلد العمل
#            [network] العنوان، الأمان، الانضمام، الحظر
#            [tasks] قائمة الانتظار، إعادة المحاولة، الجدولة، الحسابات متعددة الأنوية
#            [orca] إصدار الحملة، فحوص ORCA لدى العملاء
#            [results] الملفات المُعادة       [report] ما يبلّغ عنه العملاء أثناء التشغيل
#            [verify] فحوص السلامة، السمعة، الحجر
#            [storage] حدود القرص           [alerts] البريد الإلكتروني أو Telegram أو برنامج
#            [update] إصدارات Matriline الجديدة   [log] مستوى السجل
# قد يظهر القسم في أكثر من جزء (وتُجمع إعداداته ببساطة).
# الصيغة: عناوين [section]، و "key = value"، والتعليقات تبدأ بـ '#'. الأحجام تقبل
# KB/MB/GB/KiB/MiB/GiB أو "unlimited"؛ والمدد 90s و 30m و 1h. سياسة الشبكة كلها تُحدَّد
# هنا فقط: يتلقاها العملاء عند اتصالهم ولا يستطيعون تجاوزها.
# تُطبَّق معظم الخيارات أثناء عمل الخادم: "matriline-server config edit" يفحص الملف
# ويطبّقه (الخيارات المعلَّمة بـ [restart] تحتاج إلى إعادة تشغيل).


# ================================ أساسي ======================================
[general]
# en: language of the menus, help, web page and alerts: "en", "es", "fr", "pt", "ar" (empty: this computer's)
# es: idioma de los menús, la ayuda, la página web y las alertas: "en", "es", "fr", "pt", "ar" (vacío: el de esta computadora)
# fr: langue des menus, de l'aide, de la page web et des alertes : "en", "es", "fr", "pt", "ar" (vide : celle de cet ordinateur)
# pt: idioma dos menus, da ajuda, da página web e dos alertas: "en", "es", "fr", "pt", "ar" (vazio: o deste computador)
# ar: لغة القوائم والمساعدة وصفحة الويب والتنبيهات: "en", "es", "fr", "pt", "ar" (فارغ: لغة هذا الحاسوب؛ الترجمة العربية آلية ولم تُراجَع بعد)
language =


[spool]
# مجلد العمل (يحوي input/ output/ ... state/)؛ "." = مجلد هذا الملف [restart]
root = .


[network]
# المنفذ الذي ينتظر عليه هذا الخادم الحواسيب المساعدة. افتحه في الجدار الناري، وإن كنت
# خلف موجّه (router) فأعد توجيهه (port forwarding) إلى هذا الحاسوب [restart]. مثال: 44100
listen = 44100

# العنوان الذي تتصل به الحواسيب المساعدة للوصول إلى هنا: عنوان IP العام (أو اسم نطاق)
# والمنفذ أعلاه. يُكتب في كل ملف اعتماد: املأه قبل "keys issue". مع connection = relay
# يمكن أن يبقى فارغًا. أمثلة: 203.0.113.7:44100   lab.example.org:44100
advertise =

# كيف يُحمى الاتصال: "tls" (موصى به، كل شيء مشفّر)، أو "auth" (غير مشفّر)، أو "none" (لشبكات
# الاختبار فقط)
security = tls

# كيف يلتقيان: "direct" (تصل الحواسيب المساعدة إلى هذا الخادم عبر المنفذ أعلاه) أو "relay"
# (إن لم تستطع فتح أي منفذ: يتصل الطرفان بمُرحِّل). مثال: connection = "relay"
connection = direct

# address:port الخاص بالمُرحِّل، فقط مع connection = relay. مثال: relay.example.org:443
relay_address =

# من يمكنه الانضمام: "issued" (تنشئ ملف اعتماد لكل حاسوب مساعد؛ موصى به)، أو "register"
# (يطلب الحاسوب المساعد الانضمام برمز token وأنت توافق)، أو "open" (خطر: أي شخص يعرف
# العنوان)
enrollment = issued


[tasks]
# "order" (ترتيب قائمة الانتظار) أو "learned" (الحسابات الطويلة للعملاء السريعين)
scheduler = order

# أطول مدة يمكن أن يعمل فيها حساب واحد على حاسوب واحد. عند بلوغها يتوقف العمل وينتقل إلى
# errors/ مع المدارات (orbitals) التي وصل إليها، ويتابع 'retry' منها. 0 = بلا حد.
# أمثلة: 12h   3d
max_job_time = 1d


[orca]
# إصدار ORCA لهذه الحملة: يجب أن يستخدمه كل العملاء
version = 6.1.1

# "fingerprint" (يجب أن يطابق ORCA لدى العملاء المراجعَ أدناه) أو "version" (الثقة بهم)
check = fingerprint

# عميل لديه إصدار آخر من ORCA: "refuse" أو "separate" أو "errors"
other_versions = refuse

# تثبيت (أو تثبيتات) ORCA على هذا الحاسوب، مفصولة بفواصل (يملؤها init)
reference_paths = /opt/orca-6.1.1

# "builtin" = النسخ الرسمية (builds) لهذا الإصدار (Linux، Windows، macOS)؛ إضافةً إلى ملفات JSON من "matriline-client fingerprint"
accepted_fingerprints = builtin


[verify]
# فحوص سلامة النتائج (خياراتها في [verify] ضمن «متقدم»)
enabled = true


[storage]
# مساحة القرص التي يمكن أن يستخدمها المشروع (unlimited، أو مثلاً 500G)
limit = unlimited


[alerts]
# تصلك التنبيهات بالبريد الإلكتروني أو عبر Telegram أو بكليهما. الخطوات لكلٍّ منهما: في نهاية
# هذا الملف، [alerts]. ثم جرّبها: matriline-server test-alert
# --- بالبريد الإلكتروني
email_enabled = false

# خادم البريد ومنفذه، مثلاً smtp.gmail.com:587
smtp_server =

# الحساب المُرسِل (الحساب الذي أنشأت فيه كلمة مرور التطبيق)
smtp_user =

# الملف الذي فيه كلمة مرور التطبيق لهذا الحساب (المسار الكامل؛ لا تكتب كلمة المرور هنا أبداً)
smtp_password_file =

# اسم المُرسِل الظاهر (عادةً العنوان نفسه)
from =

# من يتلقى التنبيهات (مفصولون بفواصل)
to =

# --- عبر Telegram (أرسل أولاً /start إلى البوت الخاص بك من حسابك على Telegram)
telegram_enabled = false

# الملف الذي فيه رمز البوت (token) (المسار الكامل؛ لا تكتب الرمز هنا أبداً)
telegram_token_file =

# معرّف المحادثة (chat id) الخاص بك (رقم؛ يخبرك به @userinfobot)
telegram_chat =

# --- أو برنامج خاص بك، يُشغَّل مع كل تنبيه (الحدث، الرسالة)؛ فارغ = لا شيء
command =


[update]
# إصدارات Matriline الجديدة: off، أو "alert" (أخبرني؛ والأمر 'update apply' يثبّته)، أو "auto".
# EXPERIMENTAL (تجريبي): غير موصى به لمشروع قيد التنفيذ (انظر EXPLANATIONS)
mode = off


[log]
# "debug" أو "info" أو "warn" أو "error"
level = info


# =============================== متقدم ====================================
# القيم الافتراضية تناسب معظم المشاريع؛ كل خيار مشروح في نهاية الملف.


[spool]
keep_empty_dirs = input


[network]
accept_nosecurity_clients = false

credential_valid = 48h

blocked_ips =

max_sessions = 256

ban_garbage_after = 10

ban_garbage_window = 1h

ban_garbage_duration = 168h

ban_auth_after = 20

ban_auth_window = 24h

ban_auth_duration = 24h

ban_trust_known = true


[tasks]
reuse_checkpoints = true

heartbeat_seconds = 60

task_timeout = 1h

scan_interval = 5s

settle_time = 2s

order = alphanumeric

input_extensions = .inp

duplicate_when_idle = true

max_replicas = 2

orca_error_hosts = 2

max_attempts = 6

error_alert_after = 3

error_pause_after = 10

error_window = 24h

learned_min_samples = 30

parallel = downgrade

max_procs = 8


[orca]
accepted_tree_hashes =


[results]
include = *

exclude = *.tmp, *.tmp.*

max_bytes = 2G

compress_level = 6


[report]
fields = *

percentiles = 50, 90, 99

sample_seconds = 5


[verify]
fingerprints = true

output_consistency = true

timing_plausibility = true

scf_recheck_fraction = 0.05

gradient_check_fraction = 0.05

hessian_probe_fraction = 0.05

canary_rate = 0

replication_rate = 0

probation_results = 5

probation_replication = 0.2

probation_multiplier = 3

on_failure = weird

energy_tolerance = 1e-5

check_max_scf_iterations = 10

hessian_tolerance = 0.005

reputation = true

trusted_after = 50

trusted_multiplier = 0.5

recent_failure_window = 720h

recent_failure_multiplier = 2

second_opinion = true

second_opinion_unavailable = weird

retry_weird = true

rescue_weird = true

quarantine_after = 3

quarantine_window = 24h

quarantine_recheck = 10

quarantine_escalate_fraction = 0.25

quarantine_auto_release = true


[storage]
warn_percent = 90

min_free = auto


[alerts]
smtp_password_env = MATRILINE_SMTP_PASSWORD

# كل تنبيه: off، أو now (فوراً)، أو summary (في الملخص المجدول)
# القرص على وشك الامتلاء، أو تُرفض نتائج لنقص المساحة
storage = now

# نتيجة لم تجتز أحد الفحوص (ذهبت إلى weird/)
verify_failed = now

# وُضع عميل في الحجر (تُفحص كل نتيجة منه)
quarantine = now

# توقف عميل عن الإبلاغ عن الحسابات التي كان يشغّلها
client_lost = now

# فُقدت مهمة أو تكررت ('check')
tasks = now

# انتهت كل المدخلات: لا شيء في قائمة الانتظار ولا قيد التشغيل ولا قيد الفحص
campaign_done = now

# إصدار جديد من Matriline، أو مشكلة في تثبيته
update = now

# ذهبت مهمة إلى errors/ (فشل ORCA)، أو أُوقف عميل مؤقتاً بعد أخطاء
errors = summary

# عميل لديه إصدار من ORCA غير إصدار هذه الحملة
orca_version = summary

# انضم عميل جديد بملف اعتماده
enrolled = summary

# حُظر عنوان (ماسحات المنافذ، محاولات دخول فاشلة)
ban = summary

# يُرسل التنبيه نفسه "now" مرة واحدة على الأكثر خلال هذه المدة (والبقية تذهب إلى الملخص)
now_limit = 1h

# متى يُرسل الملخص: off, hourly, every 6h, daily 08:00, daily 08:00 20:00,
# weekdays 08:00, weekends 10:00, mon,thu 09:00, mon-fri 18:30 ...
summary = daily 08:00

# أرسل الملخص حتى عندما لا يحدث شيء ("كل شيء على ما يرام"، مع حالة المشروع)
summary_when_quiet = false


[hooks]
result =

done =


[web]
palette = A

mol_rotation = 20s

mol_background = auto

white =

black =

gray =

dark =

light =


[update]
check_interval = 720h

url = https://github.com/agaloya/matriline/releases

client_wait = 24h


# ============================= EXPLANATIONS ==================================
#
# ---------------- [general] ----------------
# >> language
# en: The language of what people read: console menus, 'help', the web page, the alerts.
#   Empty: this computer's language (LANG, or the Windows display language); English when
#   there is no translation. Logs and error messages stay in English.
# es: El idioma de lo que se lee: menús de la consola, 'help', la página web, las alertas.
#   Vacío: el idioma de esta computadora; inglés si no hay traducción. El registro y los
#   mensajes de error quedan en inglés.
# fr: La langue de ce qu'on lit : menus de la console, 'help', la page web, les alertes.
#   Vide : la langue de cet ordinateur ; l'anglais s'il n'y a pas de traduction. Le journal
#   et les messages d'erreur restent en anglais.
# pt: O idioma do que se lê: menus do console, 'help', a página web, os alertas. Vazio: o
#   idioma deste computador; inglês se não houver tradução. O log e as mensagens de erro
#   ficam em inglês.
#
# ---------------- [spool] ----------------
# >> root
# مجلد العمل. يحوي input/ output/ completed/ cancelled/ paused/ weird/ errors/
# إضافةً إلى المجلد الداخلي state/. المسارات النسبية تُحسب نسبةً إلى هذا الملف.
#
# >> keep_empty_dirs
# مجلدات الـ spool التي تُحفظ مجلداتها الفرعية الفارغة (مفصولة بفواصل). في غيرها يُحذف
# المجلد الفرعي الذي يبقى فارغاً حين تنتقل منه آخر مهمة. input = تبقى البنية التي أنشأتها
# للدفعات الجديدة؛ مثلاً "input, output" تحفظ بنية output/ أيضاً.
# ---------------- [network] ----------------
# >> accept_nosecurity_clients
# accept_nosecurity_clients: إعطاء المهام لعملاء مبنيين بـ "-tags nosecurity" (بلا بيئة
# معزولة (sandbox) ولا تدقيق للعمليات؛ مخصصون لأجهزة المرء الموثوقة). معطَّل: يُبلَّغون بذلك
# ولا يتلقون أي مهمة.
# >> listen
# عناوين TCP التي يستمع عليها الخادم [restart]. المنفذ الافتراضي 44100 (غير مخصص من IANA).
# المنفذ وحده يعني الاستماع على كل عناوين هذا الحاسوب. للاستماع على عنوان واحد فقط (حاسوب
# متصل بعدة شبكات) اكتب address:port، مثلًا 192.168.1.10:44100. تُفصل الإدخالات المتعددة
# بفواصل، مثلًا 44100, 443.
# في أكثر الشبكات تقييداً لا يُسمح إلا باتصال TCP/443 الصادر؛ وإضافة "443"
# (تتطلب صلاحيات على معظم الأنظمة) تتيح لهؤلاء العملاء الوصول إلى خادم يمكن بلوغه مباشرة.
# >> advertise
# العنوان (host:port) الذي يُكتب في ملفات الاعتماد الصادرة للعملاء. اتركه فارغاً كي
# يُسأل عنه عند إصدار المفاتيح.
# >> security
# وضع الأمان لجميع الاتصالات دون استثناء:
#   tls  - (الافتراضي، موصى به) TLS 1.3، الطرفان موثَّقان، وكل شيء مشفّر.
#   auth - كل رسالة موثَّقة ومحمية من التعديل ومن إعادة الإرسال (replay)،
#          لكنها غير مشفّرة: أي أحد على مسار الشبكة يمكنه قراءة المدخلات والنتائج.
#   none - لا حماية على الإطلاق بعد التحقق الأولي من الهوية. خطر: يمكن لمهاجم على
#          المسار قراءة كل شيء وتغييره. لشبكات الاختبار المعزولة فقط.
# >> connection, relay_address
# كيف يصل العملاء إلى هذا الخادم:
#   direct - يتصل العملاء بهذا الجهاز. يحتاج الخادم إلى منفذ TCP واحد يمكن بلوغه
#            (وجّهه في الراوتر إن كان الخادم خلف NAT). لا يحتاج العملاء أبداً
#            إلى توجيه المنافذ (port forwarding).
#   relay  - يتصل الخادم والعملاء كلاهما نحو الخارج بمُرحِّل له عنوان IP عام
#            (matriline-relay). لا يحتاج أحد إلى توجيه المنافذ. المُرحِّل يمرّر فقط
#            التدفق المحمي من طرف إلى طرف ولا يستطيع قراءته (لا يقرأ شيئاً مفيداً
#            مع security = tls؛ أما مع auth/none فيستطيع قراءة النص الصريح).
# >> enrollment
# من يمكنه الانضمام:
#   issued   - (الافتراضي) ينشئ المسؤول ملف اعتماد لكل مستخدم بالأمر
#              "matriline-server keys issue <name>" ويسلّمه إليه. الملف تذكرة
#              تُستعمل مرة واحدة: عند أول اتصال ينشئ العميل مفتاح الجهاز الخاص به
#              (لا يغادر ذلك الحاسوب أبداً) ويتوقف الملف عن العمل، فلا تمنح نسخة
#              مسروقة لاحقاً أي وصول. يمكن إلغاؤه في أي وقت.
#   register - يولّد المستخدمون مفاتيحهم بأنفسهم وينضمون برمز (token) يُستعمل مرة واحدة
#              ("matriline-server keys token")؛ ويوافق عليهم المسؤول
#              ("matriline-server clients approve <id>").
#   open     - خطر: أي جهاز يعرف العنوان ومفتاح الخادم يمكنه الانضمام وسيتلقى
#              ملفات الإدخال الخاصة بك.
# >> credential_valid
# المدة التي يمكن خلالها استعمال ملف اعتماد صادر عن "keys issue" لانضمامه الوحيد.
# >> blocked_ips
# عناوين IP تُرفض قبل أي مصافحة (handshake)، مفصولة بفواصل، بشكل دائم.
# >> max_sessions
# أقصى عدد من العملاء المتصلين في آن واحد؛ تُرفض الاتصالات الإضافية حتى ينتهي أحدها (حدّ
# يقي من سيل من الاتصالات؛ ارفعه لحملة فيها متطوعون أكثر).
# >> ban_garbage_after, ban_garbage_window, ban_garbage_duration
# الحظر التلقائي (اعرضه بالأمر "matriline-server bans"، وارفع أحدها بالأمر
# "matriline-server bans lift <address>"). القيمة 0 في خيار *_after تعطّل تلك القاعدة.
# الاتصالات التي لا تتكلم بروتوكول Matriline أبداً (ماسحات المنافذ، بروتوكولات أخرى،
# بيانات عشوائية، اتصالات فارغة): هذا العدد منها خلال النافذة الزمنية يحظر العنوان.
# >> ban_auth_after, ban_auth_window, ban_auth_duration
# الاتصالات التي تتكلم البروتوكول لكنها لا تُقبل (مفتاح مجهول أو خاطئ أو ملغى،
# أو رمز token غير صالح). قد يصيب هذا العملاءَ النزيهين أحياناً (ملف اعتماد قديم، اتصال ينقطع
# في منتصف المصافحة)، لذا يكون الحد المسموح أكبر والحظر مؤقتاً. إعادة اتصال
# العملاء المقبولين لا تُحسب أبداً.
# >> ban_trust_known
# لا يُحظر تلقائياً أبداً عنوانٌ اتصل منه عميل مسجَّل خلال آخر
# 24 h: على NAT مشترك (مكتب، فندق، شبكة هاتف محمول) كان يمكن لمهاجم بغير ذلك
# أن يتسبب في إقصاء متطوع شرعي. تبقى محاولاته الفاشلة مرفوضة ويُنبَّه عنها.
#
# ---------------- [tasks] ----------------
# >> reuse_checkpoints
# خصوصية المدخلات: يرى العملاء الجزيء والطريقة الحسابية لما يحسبونه (لا بد لهم من ذلك
# لتشغيل ORCA)؛ أما أسماء الملفات الحقيقية والمجلدات الفرعية ومن أرسلها فلا تُرسل أبداً.
# غير مُنفَّذ، اقتراح لمن يوسّع هذا الكود: خيار لإبقاء المدخلات الحساسة
# (مثلاً مجلد فرعي مثل input/private/) لعملاء مختارين فقط، وعلى العتاد الذي
# يتيح ذلك (AMD SEV-SNP، Intel TDX)، أجهزة افتراضية سرية مُصادَق عليها (attested) لا يستطيع
# مالك الحاسوب قراءة ذاكرتها (docs/DECISIONS.md D44).
# reuse_checkpoints: عندما يفشل مضيف في مهمة (عطل في الجهاز أو انتهاء المهلة، لا خطأ من
#   ORCA)، تُحفظ المدارات (.gbw) التي وصل إليها وتُعطى للمضيف التالي: يبدأ ORCA
#   منها من تلقاء نفسه (يقرأ AutoStart الملف <input name>.gbw)، فلا يبدأ حساب SCF طويل
#   من الصفر ولا يتغير ملف الإدخال. فقط من المضيفين الموثوقين (نشطون، تجاوزوا فترة الاختبار،
#   بلا فحص فاشل): ملف .gbw مزوَّر لا يمكنه تغيير الطريقة لكنه قد يوجّه SCF إلى
#   حل آخر متسق ذاتياً (مثلاً حالة مكسورة التناظر (broken-symmetry) لجذر حر).
# >> heartbeat_seconds
# يرسل العملاء نبضة (heartbeat) بهذا التواتر (بالثواني).
# >> task_timeout
# المهمة الجارية التي لا يبلّغ عنها عميلها طوال هذه المدة تُعطى لمضيف
# آخر (تبقى أول نتيجة صالحة هي الفائزة إن عاد العميل الأصلي لاحقاً).
# >> scan_interval, settle_time
# كم مرة يُعاد فحص input/ بحثاً عن ملفات جديدة، وكم يجب أن يبقى الملف الجديد
# دون تغيير قبل وضعه في قائمة الانتظار (يحمي من الملفات المنسوخة جزئياً).
# >> order, input_extensions
# ترتيب توزيع المدخلات: alphanumeric (ترتيب طبيعي للمجلدات الفرعية والملفات،
# فيُتبع الترتيب 1list, 2list, ... 10list) أو random. الأولويات الصريحة المحددة بالأمر
# "matriline-server priority" تتقدم دائماً.
# >> duplicate_when_idle, max_replicas
# حين لا تبقى مهمة في قائمة الانتظار، يمكن تكرار المهام الجارية على مضيفين خاملين كي لا
# يؤخر جهاز بطيء جداً نهاية الحملة. أول نتيجة مُتحقَّق منها تفوز.
# >> orca_error_hosts
# تذهب المهمة إلى errors/ بعد أن يفشل ORCA نفسه فيها على هذا العدد من المضيفين المختلفين.
# مشكلات الجهاز (انقطاع الكهرباء، نفاد الذاكرة، انقطاع الاتصال) لا تُحسب.
# >> max_attempts
# الحد المطلق لعدد المحاولات لكل مهمة (لأي سبب) قبل errors/.
# >> max_job_time
# أطول مدة لعمل واحد على حاسوب واحد (للأعمال المرسلة من حينها). يوقف الحاسوب المساعد العمل
# عند بلوغها ويعيد ما لديه؛ تنتقل المهمة إلى errors/ مع مداراتها (.gbw) وملاحظة (verdict)
# تشرح كيفية المتابعة: ارفع الحد، ثم 'matriline-server retry errors/<task>'، فيبدأ الحاسوب
# التالي من تلك المدارات. أما limits.max_task_time الخاص بحاسوب مساعد، إن كان أقصر، فهو
# يمرر المهمة إلى حاسوب آخر فقط.
# >> error_alert_after, error_pause_after, error_window
# أخطاء عميل واحد (أخطاء ORCA أو أعطال الجهاز، لا الغش):
# error_alert_after: تنبيه المسؤول بعد هذا العدد من الأخطاء المتتالية (0 = معطَّل).
# error_pause_after: إيقاف العميل مؤقتاً (لا مهام جديدة حتى "clients release <name>") بعد
#   هذا العدد من الأخطاء خلال error_window، مثلاً حاسوب لا يستطيع تشغيل نوع معين من الحسابات.
# >> scheduler, learned_min_samples
# scheduler: أي مهمة من قائمة الانتظار يحصل عليها العميل، ضمن أعلى مستوى أولوية:
#   order   - (الافتراضي) الترتيب المذكور أعلاه.
#   learned - يتعلم الخادم من نتائجه المقبولة كم يستغرق كل نوع من الحسابات
#             (الطريقة، مجموعة الأساس، الحجم، Opt/Freq، الغلاف المفتوح) ومدى سرعة كل
#             عميل، ثم يعطي أطول الحسابات المتوقعة لأسرع العملاء وأقصرها
#             لأبطئهم (حملات أقصر على عتاد متنوع). يحتاج أولاً إلى learned_min_samples
#             نتيجة؛ وحتى ذلك الحين، وللعملاء أو المدخلات التي لا يستطيع تقييمها،
#             يعود إلى "order". انظر "matriline-server model".
# >> parallel, max_procs
# parallel: المدخلات التي تطلب عدة أنوية ("%pal nprocs N"، "! PALN"):
#   downgrade - (الافتراضي) تعمل على نواة واحدة، مثل أي حساب آخر (عدة حسابات
#               مستقلة تستفيد من الأنوية أكثر: بالقياس، نواتان تجعلان الحساب الواحد أسرع بنحو 1.25x).
#   honor     - تعمل بعدد N من عمليات MPI (على الأكثر max_procs) على عميل يقبل حسابات
#               بهذا الحجم (resources.max_cores_per_job لديه) ولديه N نواة شاغرة؛ وإلى أن
#               يتوفر مثل هذا العميل، توزّع قائمة الانتظار المهام التالية.
#
# ---------------- [orca] ----------------
# >> version
# إصدار ORCA لهذه الحملة: يجب أن يستخدمه كل العملاء. حدّده قبل المدخلات الأولى؛
# فإن تغيّر لاحقاً ينبّه الخادم (السجل، تنبيه، دفتر القيود ledger)، لأن output/ عندئذ يخلط
# نتائج إصدارين.
# >> check
# check: كيف يُفحص ORCA لدى العميل.
#   fingerprint - (الافتراضي) كل برنامج شغّلته أي نتيجة يجب أن ينتمي إلى إحدى النسخ
#                 المرجعية أدناه: ضع هنا ORCA لكل نظام تشغيل ومعمارية يستخدمها
#                 عملاؤك (Linux x86-64، Linux arm64، Windows، macOS)، مفكوك الضغط؛
#                 الخادم يحسب تجزئة (hash) ملفاتها فقط، ولا يشغّل نسخ المنصات الأخرى.
#   version     - الثقة بتثبيتات العملاء: يكفي أن يكون الإصدار ورقم البناء (build) اللذان يكتبهما
#                 ORCA في كل ملف مخرجات (وفي البيان manifest) هما إصدار هذه الحملة.
# >> other_versions
# other_versions: ماذا يُفعل بعميل ليس لديه إصدار هذه الحملة.
#   refuse   - (الافتراضي) لا مهام له؛ يُخبَر بالإصدار الذي يجب تثبيته، ويتلقى
#              المسؤول تنبيهاً (orca_version).
#   separate - يحسب بإصداره الخاص؛ تُعدّ نتائجه منجزة لكنها تُحفظ منفصلة،
#              في other-versions/<version>/output|weird|errors، لا في output/ أبداً.
#              لا تخضع للفحص المتقاطع (فالفحص بإصدار آخر سيقارن بين برنامجين
#              مختلفين)، لذا قد يدّعي عميل إصداراً قديماً ليتفادى الفحوص: لا تستخدمه
#              إلا مع عملاء تثق بهم.
#   errors   - يحسب بإصداره الخاص، وتذهب نتائجه إلى
#              errors/other-versions/<version>/ للرجوع إليها، ويبقى ملف الإدخال في قائمة
#              الانتظار لعميل لديه إصدار هذه الحملة.
# >> reference_paths
# التثبيت (أو التثبيتات) المرجعية على هذا الجهاز، المستخدمة لحساب البصمات المتوقعة.
# يُسمح بعدة مسارات، مثلاً نسختا x86-64 و arm64 من الإصدار نفسه
# (مفكوكتا الضغط هنا؛ النسخة المبنية لمعمارية أخرى تُحسب بصمتها لكن لا يمكن تشغيلها).
# >> accepted_fingerprints
# التثبيتات المقبولة ببصمتها الكاملة، مفصولة بفواصل. "builtin" = نسخ ORCA الرسمية
# من orca.version التي يعرفها هذا البرنامج (6.1.1: Linux x86-64 و arm64، Windows x86-64،
# macOS x86-64 و arm64): تجزئات فقط، فلا يحتاج هذا الخادم إلى ORCA إطلاقاً
# (يمكن أن يبقى reference_paths فارغاً؛ العملاء يحسبون كل فحص). نسخ أخرى: ملفات
# JSON تُنشأ على عميل بالأمر "matriline-client fingerprint". أفضل من accepted_tree_hashes: إذ
# يستطيع الخادم حينها فحص كل برنامج شغّلته النتيجة، حتى للنسخ التي لا يستطيع تشغيلها هنا
# أو التي لا تطبع تجزئة GIT (نسخة ORCA 6.1.1 الرسمية لمعمارية arm64).
# >> accepted_tree_hashes
# بصمات تثبيت إضافية مقبولة (تجزئات الشجرة tree hashes)، مفصولة بفواصل، مثلاً عندما
# لا يكون ORCA مثبتاً على جهاز الخادم.
#
# ---------------- [results] ----------------
# >> include, exclude
# أي الملفات التي ينتجها ORCA تُعاد (أنماط glob). الافتراضي: كل شيء ما عدا ملفات
# ORCA المؤقتة (*.tmp و *.tmp.N: تكاملات ونتائج وسيطة، غالباً بالـ GB، لا فائدة منها
# بعد ذلك؛ ترك حساب DLPNO فاشل 6.7 GB من *.tmp.0 في المختبر). يحذف العملاء ما
# لا يُعاد. لاستلامها رغم ذلك، اترك exclude فارغاً.
# مثال لتوفير عرض النطاق: include = *.out, *.property.txt, *.xyz
# >> max_bytes
# رفض النتائج الأكبر من هذا (يحمي قرصك من العملاء الخبيثين). كبير بما يكفي
#   للنتائج العادية (.gbw، .hess، المسارات trajectories)؛ ملفات ORCA المؤقتة مستبعدة أعلاه.
# >> compress_level
# ضغط الملفات المنقولة: 0 = بلا ضغط ... 9 = أصغر حجم (استهلاك CPU أكبر). 6 متوازن.
#
# ---------------- [report] ----------------
# >> fields
# حقول تقرير البيانات الوصفية لكل تشغيل (matriline.report) التي تُجمع من العملاء.
# "*" = الكل. البادئات المنتهية بـ '*' تختار مجموعات، مثلاً: time.*, cpu.*, mem.*, net.*
# >> percentiles
# المئينات التي يُبلَّغ عنها للسلاسل المأخوذة عيناتها (درجات الحرارة، الذاكرة، RTT، ...).
# >> sample_seconds
# فترة أخذ العينات لقياسات العميل (telemetry) أثناء تشغيل حساب (بالثواني).
#
# ---------------- [verify] ----------------
# >> enabled
# غير مُنفَّذ، اقتراح لمن يوسّع هذا الكود: المصادقة العتادية (hardware attestation). على
# المعالجات التي تدعم الحوسبة السرية (AMD SEV-SNP، Intel TDX) يمكن لعميل أن يشغّل ORCA في
# جهاز افتراضي سري مُصادَق عليه لا يستطيع مالك الحاسوب قراءة ذاكرته ولا تغييرها، وأن
# يرسل تقريراً موقَّعاً من العتاد بأن تلك الصورة بعينها هي التي عملت؛ وعندئذ قد تحتاج نتائج
# هؤلاء العملاء إلى فحوص أقل مما يلي، وتبقى مدخلاتهم خاصة (docs/DECISIONS.md D44).
# التحقق من السلامة. كل نتيجة يوقّعها عميلها دائماً وتُسجَّل في دفتر قيود الخادم
# المتسلسل بالتجزئات (وهذا يحدد من أنتجها). القيم الافتراضية تفعّل كل طبقة
# لا تكلّف حساباً، وتفحص عينة 5 % بالفحوص النشطة الرخيصة: في جولات الهجوم
# في المختبر كشف هذا كل تزوير بكلفة أقل بكثير من 1 % من الحساب الإضافي
# (docs/SECURITY_TESTS.md). العميل المحجور يواصل الحساب، لكن كل نتيجة
# يعيدها تُفحص.
# كل طبقة أخرى تكلّف حساباً إضافياً؛ النسب من 0 إلى 1 (1 = كل نتيجة).
#
# enabled: المفتاح الرئيسي. false = لا طبقة سلامة على الإطلاق، مهما قالت الخيارات
#   أدناه (للحواسيب التي تثق بها تماماً)؛ تبقى النتائج موقَّعة. وتُفحص النتائج مع ذلك
#   بحثاً عن أخطاء ORCA والتحسينات الهندسية غير المتقاربة. true = تطبيق الخيارات أدناه.
# >> fingerprints
#
# fingerprints: يحسب العميل تجزئة تثبيت ORCA كاملاً وكل برنامج شغّله
#   فعلاً. يكشف الإصدارات الخاطئة والتثبيتات التالفة. العميل المعدَّل عمداً يمكنه
#   الكذب، لذا يكشف هذا الأخطاء غير المقصودة في الأساس.
# >> output_consistency
# output_consistency: تحليل مخرجات ORCA: الإصدار وتجزئة GIT، الانتهاء الطبيعي،
#   الإدخال المعروض في المخرجات مطابق لإدخال المهمة، الوحدات (modules) المتوقعة. مجاني، موصى به.
# >> timing_plausibility
# timing_plausibility: زمن التشغيل الذي يدّعيه العميل ويطبعه ORCA لا يمكن أن يتجاوز
#   الوقت المنقضي منذ إسناد المهمة (+2 min). يكشف المخرجات المنسوخة من مكان آخر. مجاني.
# >> scf_recheck_fraction
# scf_recheck_fraction: إعادة حساب الطاقة من المدارات المُعادة (.gbw) بدورة SCF
#   واحدة فقط على مضيف آخر: النتيجة المتقاربة الأصيلة تعيد الطاقة نفسها
#   وتتقارب فوراً. الكلفة ~5% من حساب SCF. يتطلب إعادة ملفات .gbw.
# >> gradient_check_fraction
# gradient_check_fraction: في التحسينات الهندسية، حساب التدرج عند البنية النهائية
#   على مضيف آخر؛ يجب أن يكون ~0. الكلفة ~حساب تدرج واحد.
# >> hessian_probe_fraction
# hessian_probe_fraction: في حسابات الترددات، مقارنة H*v من مصفوفة هيسه (Hessian) المُعادة
#   مع فرق محدود لتدرجين على امتداد اتجاه عشوائي سري v.
# >> canary_rate
# canary_rate: لكل مهمة حقيقية تُسند، احتمال أن تُرسل إلى العميل نفسه أيضاً مهمة
#   إجابتها معروفة (نتيجة سابقة مُتحقَّق منها، مُدوَّرة ومُزاحة ومُعاد ترتيب ذراتها عشوائياً كي
#   لا يمكن التعرف عليها). الكلفة: canary_rate حساب نقطة مفردة (single point) إضافي لكل مهمة.
# >> replication_rate
# replication_rate: نسبة المهام التي تُشغَّل أيضاً على مضيف ثانٍ مختلف وتُقارن نتائجها.
# >> probation_results
# العملاء الجدد يخضعون لفحوص أكثر بـ "probation_multiplier" مرة في أول N نتيجة لهم.
# >> probation_replication, probation_multiplier
# probation_replication: خلال فترة الاختبار، إعادة حساب هذه النسبة أيضاً من نتائج العميل
#   على مضيف آخر (الفحص العام لأنواع الحسابات التي لا تستطيع الفحوص الرخيصة إعادة بنائها).
# >> on_failure
# ما يحدث عند فشل فحص: weird (تذهب النتيجة إلى weird/، ويواصل العميل العمل)
# أو quarantine (ويتوقف أيضاً إرسال المهام إلى ذلك العميل ويُعاد فحص نتائجه السابقة).
# >> energy_tolerance
# أقصى فرق في الطاقة (Hartree) يُقبل عند مقارنة حسابين (نسخ متماثلة replicas).
# المضيفون النزيهون يختلفون حتى ~2e-6 Eh (رُصد ذلك مع UKS + RIJCOSX في المختبر)؛ و 1e-5 Eh تساوي
# 0.006 kcal/mol، وهي أقل بكثير من أي تزوير مفيد كيميائياً (كُشف تزوير بمقدار 2e-4 Eh).
# >> check_max_scf_iterations
# check_max_scf_iterations: الحد الأقصى لدورات SCF في فحوص scf/gradient، التي تبدأ من
#   المدارات المُعادة (المدارات الأصيلة تتقارب في بضع دورات؛ رُصدت 4 دورات لجزيء الفينول).
#   الفحص الذي لا يتقارب ضمن الحد يكون غير حاسم، وليس دليلاً على الغش:
#   تذهب النتيجة إلى errors/ مع حكم يذكر اسم هذا الخيار، كي تتمكن من رفعه
#   واستخدام "retry". قيمة أعلى = فحوص غير حاسمة أقل، وحساب أكثر قليلاً لكل فحص.
# >> hessian_tolerance
# hessian_tolerance: أكبر عدم تطابق نسبي ||H v - finite difference|| يقبله مسبار
#   مصفوفة هيسه. تشغيلات نزيهة قيست في المختبر: HF 0.00004، PBE 0.0006، B3LYP/RIJCOSX
#   0.0018 (الشبكات العددية). مصفوفة هيسه مضخَّمة بنسبة x % تعطي نحو x/100، لذا فإن 0.005
#   يكشف الترددات المُزاحة بأكثر من ~0.25 % (القيمة 0.02 سمحت بمرور تزوير بنسبة 2 %).
# >> reputation, trusted_after, trusted_multiplier, recent_failure_window, recent_failure_multiplier, second_opinion
# second_opinion: عندما تُجرى كل الفحوص الفرعية لنتيجة ما على مضيف واحد، يُكرَّر أرخصها
#   (SCF أو التدرج أو النسخة المتماثلة) على مضيف مستقل آخر قبل قبولها، ويُعامَل
#   اختلاف المتحققين على أنه نزاع (weird/، دون معاقبة أحد). يحمي من
#   عميلين متواطئين يوافق كل منهما على نتائج الآخر المزوّرة (اختبار مختبري: 6 من
#   12 تزويراً مرت دونه). الكلفة: فحص إضافي رخيص واحد للفحوص التي جرت على مضيف واحد.
# السمعة (بعد فترة الاختبار): العميل الذي اجتاز trusted_after فحصاً دون أي فحص
#   فاشل خلال recent_failure_window تُضرب نسب فحصه في trusted_multiplier
#   (لا تصبح صفراً أبداً: يبقى أخذ العينات غير قابل للتنبؤ)؛ والعميل الذي لديه فحص
#   فاشل خلال تلك النافذة تُضرب نسبه في recent_failure_multiplier بدلاً من ذلك.
# >> second_opinion_unavailable
# second_opinion_unavailable: ماذا يُفعل بنتيجة فُحصت على مضيف واحد حين لا يتوفر
#   مضيف مستقل آخر لإبداء الرأي الثاني (لا أحد متصل، أو انتهت المهلة):
#   weird (الافتراضي، اختاره المستخدم) يرسلها إلى weird/ لفحص ترجيحي أو إعادة
#   حساب؛ accept يبقيها (فقد اجتازت فحصاً واحداً). على خادم لديه أقل من ثلاثة
#   عملاء لا يوجد مضيف ثالث أبداً: هناك يرسل "weird" كل نتيجة مفحوصة تقريباً
#   إلى weird/ (ويُسجَّل تحذير)، لذا قد تفضّل الإعدادات الصغيرة accept.
# >> retry_weird
# retry_weird: عندما تنتهي نتيجة في weird/، يُعاد ملف إدخالها إلى نهاية قائمة الانتظار
#   (مرة واحدة لكل مهمة)، مع استبعاد العميل الذي أنتجها؛ وتبقى النتيجة المشبوهة في
#   weird/ للمراجعة. false = ترك المهمة دون إنجاز (ويذكر ذلك تنبيه).
# >> rescue_weird
# rescue_weird: النتيجة في weird/ التي لا دليل فيها على الغش (اختلاف المتحققين، أو
#   فحص فاشل لم يستطع أحد تأكيده) تخضع أولاً لفحص ترجيحي رخيص واحد (إعادة فحص SCF،
#   أو نسخة متماثلة بلا مدارات) على مضيف لم يشارك؛ فإن اجتازته، تعود النتيجة
#   إلى output/ ولا يُعاد حساب المهمة. وإلا يُطبَّق retry_weird.
#   التزويرات المؤكدة (مضيفان ضد المنتِج) لا تُنقذ أبداً.
# >> same_host
# يمكن أن تُجرى الفحوص على الحاسوب الذي أنتج النتيجة. لحاسوب واحد فقط
# (Nacomline): هناك يمكنها كشف جهاز معيب (ذاكرة تالفة، ارتفاع الحرارة)، لا كشف غشاش أبداً.
# الافتراضي false: تُفحص النتيجة دائماً على حاسوب آخر.
# >> quarantine_after, quarantine_window, quarantine_recheck
# quarantine_after: العميل الذي لديه هذا العدد من عمليات التحقق الفاشلة خلال quarantine_window
#   يوضع في الحجر تلقائياً: يواصل الحساب، وتُفحص كل نتيجة يعيدها،
#   ويُنبَّه المسؤول (الأمر "clients drain" يوقف مهامه كلياً). الإخفاقات
#   المنفردة يُتسامح معها. 0 = لا حجر تلقائي أبداً.
# quarantine_recheck: عند أي حجر (تلقائي أو من المسؤول)، يُعاد التحقق من هذا العدد من
#   أحدث نتائج العميل المقبولة على مضيفين مستقلين (0 = لا شيء).
# >> quarantine_escalate_fraction
# quarantine_escalate_fraction: إن كانت نتيجة أُعيد فحصها سيئة، يُعاد فحص هذه النسبة من جميع
#   نتائج العميل المقبولة (عينة عشوائية؛ 1 = كلها، 0 = بلا تصعيد).
# >> quarantine_auto_release
# quarantine_auto_release: الإفراج عن العميل تلقائياً عندما تكون كل إعادات فحصه
#   صحيحة (قد يخطئ الكشف؛ لا يحتاج أحد إلى رفع الحظر عن العملاء يدوياً). تبقى النتائج السيئة
#   في weird/ وتُعاد محاولة مهامها في كل الأحوال.
#
# ---------------- [storage] ----------------
# >> limit, warn_percent
# أقصى مساحة قرص للـ spool (output/ وغيره). unlimited افتراضياً. تُرفض النتائج
# الجديدة (يحتفظ بها العملاء ويعيدون المحاولة لاحقاً) عند بلوغ الحد.
# >> min_free
# يُبقى على الأقل هذا القدر حراً على القرص الذي يحوي المشروع: النتيجة التي ستترك
# أقل منه (مع احتساب عمليات الرفع الجارية) تُرفض ويعيد العميل المحاولة لاحقاً. يمنع ذلك
# أي شخص لديه مفتاح، أو حساباً خرج عن السيطرة، من ملء القرص. auto = 5 % من القرص، على
# الأكثر 5G (قيمة ثابتة 5G رفضت كل النتائج على قرص صغير 8 GB في المختبر)؛ 0 = معطَّل.
#
# ---------------- [alerts] ----------------
# >> email_enabled, smtp_server, smtp_user, smtp_password_file, from, to, smtp_password_env
# التنبيهات بالبريد الإلكتروني، تُرسل عبر SMTP (يصلح أي حساب بريد؛ لا حاجة إلى مشروع
# Google Cloud ولا OAuth). لا تكتب كلمة المرور في هذا الملف أبداً: مكانها smtp_password_file (ملف
# فيه كلمة المرور وحدها، لا يقرؤه أحد غيرك). أما smtp_password_env فيسمّي متغير بيئة
# بدلاً من ذلك (الخدمة لا ترى متغيرات الطرفية لديك: استخدم الملف).
#
# خطوة بخطوة (Gmail؛ المزودون الآخرون مشابهون، انظر صفحة المساعدة "SMTP" لديهم):
#   1. استخدم حساباً للتنبيهات (حساب جديد فكرة جيدة) وفعّل فيه التحقق بخطوتين
#      (2-Step Verification): https://myaccount.google.com/security
#   2. اذهب مباشرة إلى https://myaccount.google.com/apppasswords (القوائم تخفيها)، واكتب
#      "Matriline" واضغط Create (إنشاء). يعرض Google 16 حرفاً مرة واحدة فقط.
#   3. احفظها في ملف لا يقرؤه غيرك، دون أن تظهر على الشاشة:
#        Linux/macOS: umask 077; read -rs -p "App password: " p; printf '%s' "$p" > ~/.keys/matriline-mail; unset p
#        Windows (PowerShell): $p = Read-Host -AsSecureString "App password";
#          [Net.NetworkCredential]::new('', $p).Password | Set-Content -NoNewline $HOME\matriline-mail
#   4. في [alerts] في الأعلى: email_enabled = true, smtp_server = smtp.gmail.com:587,
#      smtp_user = عنوان الحساب الذي أنشأت فيه كلمة مرور التطبيق (عنوان حساب
#      آخر يُرفض: "Username and Password not accepted")،
#      smtp_password_file = المسار الكامل للملف
#      (مثلاً /home/<you>/.keys/matriline-mail)، from = ذلك العنوان، to = من يتلقى
#      التنبيهات.
#   5. matriline-server config reload، ثم matriline-server test-alert: يجب أن تصل رسالة
#      اختبار (ابحث في مجلد البريد العشوائي spam في المرة الأولى).
# إن قال Google إن الخيار "is not available for your account" (غير متاح لحسابك): فالتحقق
# بخطوتين معطَّل، أو الحساب تابع لمؤسسة تحظر كلمات مرور التطبيقات (استخدم حساباً
# آخر، أو Telegram). مزودون آخرون: Yahoo smtp.mail.yahoo.com:587 (كلمة مرور تطبيق)، أو
# خادم شركة أو مؤسسة: اسأل قسم تقنية المعلومات فيها. الاتصال مشفّر (STARTTLS).
# >> telegram_enabled, telegram_token_file, telegram_chat
# التنبيهات عبر Telegram، من بوت خاص بك (الطريقة الأسهل). خطوة بخطوة:
#   1. في Telegram، افتح @BotFather، وأرسل /newbot، وأعطِ البوت اسماً (مثلاً "تنبيهات
#      Matriline الخاصة بي") واسم مستخدم ينتهي بـ "bot". يجيب BotFather برمز (token).
#   2. احفظ الرمز في ملف لا يقرؤه غيرك (كما في الخطوة 3 من البريد أعلاه)، مثلاً
#        umask 077; read -rs -p "Bot token: " t; printf '%s' "$t" > ~/.keys/matriline-telegram; unset t
#   3. افتح البوت الجديد في Telegram (ابحث عن اسم المستخدم الخاص به) وأرسل إليه /start. من دون
#      ذلك لا يستطيع البوت مراسلتك.
#   4. معرّف المحادثة الخاص بك: افتح @userinfobot في Telegram وأرسل /start؛ فيجيب بالـ
#      Id الخاص بك (رقم).
#   5. في [alerts] في الأعلى: telegram_enabled = true, telegram_token_file = المسار الكامل
#      لملف الرمز، telegram_chat = الـ Id الخاص بك.
#   6. matriline-server config reload، ثم matriline-server test-alert: يراسلك
#      البوت. لمجموعة: أضف البوت إلى المجموعة، واستخدم معرّف المجموعة (سالب).
# >> command
# الأمر test-alert (أو 'alerts test') يرسل تنبيه اختبار فوراً عبر كل قناة
# مفعّلة، ويذكر أيّها نجح. برنامج التنبيهات: يُشغَّل مع كل تنبيه (الأحداث والحد نفسها) بوسيطين، الحدث
# والرسالة، ومن دون shell؛ مثلاً سكربت يرسله عبر Telegram أو ntfy. (Telegram
# مدمج: telegram_enabled.)
# مسار مطلق؛ فارغ = معطَّل. يمكن أن يعمل 30 s على الأكثر.
# >> storage, verify_failed, quarantine, client_lost, tasks, campaign_done, update, errors, orca_version, enrolled, ban
# لكل تنبيه: off أو now أو summary. now: يُرسل بالبريد (ويُعطى لبرنامج التنبيهات)
# فوراً؛ التنبيه نفسه مرة واحدة على الأكثر خلال now_limit، والبقية تذهب إلى الملخص. summary:
# تُحفظ وتُرسل معاً وفق جدول الملخص. off: في state/events.log فقط. الملفات
# المكتوبة قبل هذه الخيارات ("events = ..." و "digest = ...") تحتفظ بمعناها.
# >> now_limit
# يُرسل التنبيه نفسه "now" مرة واحدة على الأكثر خلال هذه الفترة (الافتراضي 1h).
# >> summary
# متى يُرسل الملخص، بكلمات بسيطة: off; hourly; every 30m, every 6h (بدءاً من
# منتصف الليل); daily 08:00 (عدة مرات: daily 08:00 20:00); weekdays 08:00;
# weekends 10:00; mon,thu 09:00; mon-fri 18:30; weekly mon 09:00. وفق ساعة هذا الحاسوب.
# التنبيهات المحفوظة عند توقف الخادم تُرسل حينها.
# >> summary_when_quiet
# true: يُرسل الملخص حتى عندما لم يقع أي تنبيه، مع حالة المشروع (رسالة
# يومية "كل شيء على ما يرام")؛ false: فقط عندما يكون هناك ما يُبلَّغ عنه.
#
# ---------------- [hooks] ----------------
# برامج تُشغَّل عند حدوث شيء ما، لنقل النتائج أو نسخها أو رفعها أو تسلسلها (مسار
# مطلق؛ فارغ = لا شيء). تعمل واحداً تلو الآخر، دون shell، 10 دقائق على الأكثر لكل منها؛
# ويُسجَّل الفشل ويُدوَّن في state/events.log.
# >> result
# يُشغَّل مع كل نتيجة تصل إلى output/ أو weird/ أو errors/ أو تنتقل إليها، مع
# الوسائط: result <task> <output|weird|errors> <result folder> (وأيضاً في البيئة:
# MATRILINE_EVENT, MATRILINE_TASK, MATRILINE_VERDICT, MATRILINE_RESULT_DIR). مثال:
# سكربت ينسخ نتائج output/ إلى مجلد سحابي، أو يكتب ملف الإدخال التالي في سلسلة
# (مثلاً حساب ترددات انطلاقاً من بنية هندسية محسَّنة) في input/.
# >> done
# يُشغَّل عندما تفرغ قائمة الانتظار (كل المدخلات منجزة، ولا شيء قيد التشغيل): done <summary>.
#
# ---------------- [web] ----------------
# >> palette
# ألوان صفحة الويب: A (الافتراضي) أو B، أو نسختاهما الداكنتان A-dark و B-dark.
# لكل لوحة خمسة ألوان.
# >> mol_rotation
# العرض ثلاثي الأبعاد (3D) للجزيء يدور من تلقاء نفسه دورة كاملة كل هذه المدة (الافتراضي 20s)؛
# 0 = يبقى ثابتاً (يمكن دائماً تدويره بالفأرة).
# >> mol_background
# خلفية العرض ثلاثي الأبعاد: auto (أسود مع لوحة داكنة، وأبيض مع لوحة فاتحة) أو
# لون (ست خانات ست عشرية).
# >> white, black, gray, dark, light
# استبدال لون واحد من اللوحة (ست خانات ست عشرية، مثلاً f0f7f4؛ فارغ = لون
# اللوحة): white هو الخلفية، و black النص عليها (النص على الأسود أبيض)،
# و gray الخطوط والنص الثانوي، و dark التبويب المحدد والخيار المختار
# والأزرار القابلة للاستخدام، و light الخيارات غير المختارة وما لا يمكن استخدامه.
# يُطبَّق عند بدء 'matriline-server web'.
#
# ---------------- [update] ----------------
# >> mode
# EXPERIMENTAL (تجريبي)، غير موصى به لمشروع قيد التنفيذ: لا يوجد بعدُ ترحيل
# للإعدادات ولا للمجلدات، لذا قد يُربك إصدارٌ غيّر صيغتها تنظيمَ
# المشروع. الأكثر أماناً: التحديث يدوياً بين المشاريع (INSTALL.md).
# off: لا يبحث أبداً. alert: مرة كل check_interval يبحث الخادم عن إصدار جديد
# ويخبرك (تنبيه 'update' في قسم التنبيهات)؛ والأمر 'matriline-server update apply'
# يثبّته. auto: يثبّته أيضاً من تلقاء نفسه. لا يتم التثبيت إلا إذا استطاع كل
# عميل التحديث (كلٌّ منهم يذكر ذلك عند اتصاله؛ 'update status' يسرد من لا
# يستطيعون)، العملاء أولاً (كلٌّ منهم بين حساباته)، ثم هذا الخادم، الذي يُعاد تشغيله.
# لا تُثبَّت إلا الإصدارات الموقَّعة بمفتاح القائم على صيانة Matriline، المضمَّن في البرامج:
# ولا حتى من يتحكم في صفحة الإصدارات أو في هذا الخادم يستطيع أن يجعل
# عميلاً يثبّت أي شيء آخر. يبقى البرنامج السابق باسم <program>.previous.
# >> check_interval
# كم مرة يُبحث (الافتراضي 720h، أي 30 يوماً).
# >> url
# مكان الإصدارات الموقَّعة: صفحة الإصدارات في GitHub (أو مرآة لها البنية نفسها:
# latest/download/release.json، download/v<version>/<program>). العملاء يحمّلون من
# update_url الخاص بهم، لا من هنا.
# >> client_wait
# العميل الذي يبقى على الإصدار القديم بعد هذه المدة (ينتظر انتهاء حساباته) يُبلَّغ
# عنه؛ ويواصل الخادم انتظاره قبل تثبيت إصداره هو.
#
# ---------------- [log] ----------------
# >> level
# debug, info, warn, error
